# Copia este fichero a .env y rellena los valores. .env NO se versiona.

# --- Telegram (obligatorio para alertas reales; con --dry-run no hace falta) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Canal separado para la watchlist personal (alerting.watchlist.separate_channel).
# Si se deja vacio, la watchlist va al canal principal.
TELEGRAM_CHAT_ID_WATCHLIST=

# --- Proveedores opcionales ---
# FMP: solo enriquecimiento opcional en Fase 1 (el tier gratuito son 250 req/dia, solo US).
FMP_KEY=
# EODHD: Fase 2 (global).
EODHD_KEY=
