# Copy this file to .env and fill in the values. .env is not versioned.

# --- Telegram (required for real alerts; not needed with --dry-run) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Separate channel for the personal watchlist (alerting.watchlist.separate_channel).
# If left empty, the watchlist goes to the main channel.
TELEGRAM_CHAT_ID_WATCHLIST=

# --- Optional providers ---
# FMP: optional enrichment only in Phase 1 (free tier is 250 req/day, US only).
FMP_KEY=
# EODHD: Phase 2 (global).
EODHD_KEY=
